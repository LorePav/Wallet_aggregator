# ============================================================
# Frontend — variabili d'ambiente (modello)
# Copia questo file in ".env" e inserisci i valori reali.
# NON committare mai il file ".env" (è in .gitignore).
# ============================================================

# Progetto Supabase (autenticazione lato browser).
VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon-publishable

# URL del backend.
# In locale puoi anche ometterlo: il default è http://127.0.0.1:8000.
# In deploy (Vercel) va impostato all'URL del backend Render.
# VITE_API_URL=https://wallet-aggregator.onrender.com

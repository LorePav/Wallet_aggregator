# ============================================================
# Backend — variabili d'ambiente (modello)
# Copia questo file in ".env" e inserisci i valori reali.
# NON committare mai il file ".env" (è in .gitignore).
# ============================================================

# Connessione al database PostgreSQL (Supabase).
# Formato: postgresql://utente:password@host:porta/nome_db
DATABASE_URL=postgresql://utente:password@host:5432/postgres

# Progetto Supabase (usati per verificare i token di autenticazione).
SUPABASE_URL=https://il-tuo-progetto.supabase.co
SUPABASE_ANON_KEY=la-tua-chiave-anon-publishable

# Email per i report automatici del modulo Ailyst.
GMAIL_USER=la-tua-email@gmail.com
GMAIL_APP_PASSWORD=la-tua-app-password

# (Opzionale) Origini CORS consentite, separate da virgola.
# In locale, se non impostata, sono già permessi localhost:5173/4173.
# CORS_ORIGINS=https://wallet-aggregator-two.vercel.app
